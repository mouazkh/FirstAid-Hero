<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.FirstAidHero">
        <activity android:name=".ui.screens.SettingsActivity" android:exported="false" />
        <activity android:name=".ui.screens.OnboardingActivity" android:exported="false" />
        <activity android:name=".ui.screens.EmergencyDetailActivity" android:exported="false" />
        <activity android:name=".ui.screens.ContactsActivity" android:exported="false" />
        <activity android:name=".ui.screens.TreatedCasesActivity" android:exported="false" />
        <activity android:name=".ui.screens.MainActivity" android:exported="false" />
        <activity android:name=".ui.screens.SplashActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
